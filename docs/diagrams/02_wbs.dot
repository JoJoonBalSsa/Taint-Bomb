digraph WBS {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t"; fontsize=22;
  label="Taint-Bomb — Work Breakdown Structure (WBS)";
  node [fontname="Helvetica", shape=box, style="filled", fontsize=11, color="#1F2937"];
  edge [color="#6B7280", arrowhead=none];
  nodesep=0.18; ranksep=1.0;

  root [label="0  Taint-Bomb\nAuto Java Obfuscator", shape=box, style="filled,bold", fillcolor="#1E3A8A", fontcolor="white", fontsize=14];

  /* Level-1 work packages */
  wp1 [label="1  Plugin Platform & UI", fillcolor="#3B82F6", fontcolor="white"];
  wp2 [label="2  Orchestration Services", fillcolor="#3B82F6", fontcolor="white"];
  wp3 [label="3  Taint Analysis Engine", fillcolor="#3B82F6", fontcolor="white"];
  wp4 [label="4  Obfuscation Engine", fillcolor="#3B82F6", fontcolor="white"];
  wp5 [label="5  Build & Packaging", fillcolor="#3B82F6", fontcolor="white"];
  wp6 [label="6  Integrity & QA", fillcolor="#3B82F6", fontcolor="white"];

  root -> {wp1 wp2 wp3 wp4 wp5 wp6};

  /* WP1 */
  n11 [label="1.1 Tool window\n(Execution / Config / Logs)", fillcolor="#DBEAFE"];
  n12 [label="1.2 Settings store\n(flags, API key)", fillcolor="#DBEAFE"];
  n13 [label="1.3 Console viewer / logger", fillcolor="#DBEAFE"];
  n14 [label="1.4 Activation listener", fillcolor="#DBEAFE"];
  wp1 -> {n11 n12 n13 n14};

  /* WP2 */
  n21 [label="2.1 Service entry\n(Backgroundable task)", fillcolor="#DBEAFE"];
  n22 [label="2.2 Pre-task\n(copy · venv · pip · scripts)", fillcolor="#DBEAFE"];
  n23 [label="2.3 Pipeline coordinator\n(TasksManager)", fillcolor="#DBEAFE"];
  n24 [label="2.4 Subprocess driver\n(ManageObfuscate)", fillcolor="#DBEAFE"];
  wp2 -> {n21 n22 n23 n24};

  /* WP3 */
  n31 [label="3.1 AST parsing\n(astParser / javalang)", fillcolor="#D1FAE5"];
  n32 [label="3.2 Source/sink extraction\n(variableExtractor)", fillcolor="#D1FAE5"];
  n33 [label="3.3 Flow tracking\n(flowTracker)", fillcolor="#D1FAE5"];
  n34 [label="3.4 Sensitivity DB & rules", fillcolor="#D1FAE5"];
  n35 [label="3.5 Reporting\n(report / resultManager / LLM)", fillcolor="#D1FAE5"];
  wp3 -> {n31 n32 n33 n34 n35};

  /* WP4 */
  n41 [label="4.1 String obfuscation\n(encrypt / split / insert)", fillcolor="#FEF9C3"];
  n42 [label="4.2 Control-flow & method\n(flatten / split / opaque)", fillcolor="#FEF9C3"];
  n43 [label="4.3 Operator & dummy code", fillcolor="#FEF9C3"];
  n44 [label="4.4 Identifier obfuscation", fillcolor="#FEF9C3"];
  n45 [label="4.5 Level driver\n(per-sensitivity policy)", fillcolor="#FEF9C3"];
  n46 [label="4.6 Apply / write-back", fillcolor="#FEF9C3"];
  wp4 -> {n41 n42 n43 n44 n45 n46};

  /* WP5 */
  n51 [label="5.1 Build-manager detect\n(Gradle / Maven)", fillcolor="#FCE7F3"];
  n52 [label="5.2 Jar packaging", fillcolor="#FCE7F3"];
  n53 [label="5.3 Output folder & cleanup", fillcolor="#FCE7F3"];
  wp5 -> {n51 n52 n53};

  /* WP6 */
  n61 [label="6.1 Script SHA-256 integrity\n(check_hash)", fillcolor="#FFE4E6"];
  n62 [label="6.2 Java syntax check", fillcolor="#FFE4E6"];
  n63 [label="6.3 Safety-net validation\n(safe_transform)", fillcolor="#FFE4E6"];
  n64 [label="6.4 Test suites\n(obfuscation_tests / fuzz)", fillcolor="#FFE4E6"];
  wp6 -> {n61 n62 n63 n64};
}
